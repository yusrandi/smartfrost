 <Worksheet ss:Name="Ringkasan &amp; Rumus">
  <Table ss:DefaultColumnWidth="120">
   <Column ss:Width="220"/>
   <Column ss:Width="160"/>
   <Column ss:Width="140"/>
   <Column ss:Width="260"/>

   <Row ss:Height="24">
    <Cell ss:StyleID="Header1"><Data ss:Type="String">LAPORAN AUDIT &amp; PERHITUNGAN FROSTSCORE</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell><Data ss:Type="String">Sistem Monitoring Rantai Dingin Perikanan - SMART-FROST Kabupaten Pangkep</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell><Data ss:Type="String">Target Coolbox: SFR-CB-01 | Tanggal Audit: Kamis, 29 Oktober 2026</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>

   <Row ss:Height="20">
    <Cell ss:StyleID="Header2"><Data ss:Type="String">1. PARAMETER STANDAR PERHITUNGAN</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Batas Suhu Aman Ikan Segar (T_safe)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">4.0</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">°C</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Sesuai SNI &amp; Spesifikasi Cold-Chain</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Batas Toleransi Dosis Termal (DH_limit)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">15.0</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">°C·jam</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Batas akumulasi paparan panas maksimum</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Batas Variansi Suhu Maksimum (Var_limit)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">4.0</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">°C²</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Toleransi kestabilan termal wadah</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Interval Pencatatan Telemetri Sensor (dt)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Menit (0.0833 jam)</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Frekuensi kirim data IoT</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>

   <Row ss:Height="20">
    <Cell ss:StyleID="Header2"><Data ss:Type="String">2. HASIL ANALISIS TELEMETRI DATABASE</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Total Titik Data Riwayat (k)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">129</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Sampel</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Jumlah pencatatan sensor di /history</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Suhu Udara Terakhir (latest air_temp)</Data></Cell>
    <Cell ss:StyleID="CellHot"><Data ss:Type="Number">17.4</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">°C</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">HANGAT (&gt;4°C, Melanggar batas aman)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Suhu Air/Es Terakhir (latest water_temp)</Data></Cell>
    <Cell ss:StyleID="CellCold"><Data ss:Type="Number">-0.19</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">°C</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">DINGIN (Sensor es di dasar coolbox)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Rata-rata Suhu Udara Riwayat (Mean)</Data></Cell>
    <Cell ss:StyleID="CellHot"><Data ss:Type="Number">19.71</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">°C</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Rata-rata seluruh data udara di wadah</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Jumlah Pelanggaran Suhu (&gt;4°C)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">129</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Sampel (100.0%)</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Semua sampel udara melanggar batas!</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Total Dosis Termal Kumulatif (DH)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">168.84</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">°C·jam</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Jauh melampaui batas toleransi 15°C·jam</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Variansi Fluktuasi Suhu (Variance)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">39.45</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">°C²</Data></Cell>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Suhu tidak stabil (turun dari 34°C ke 14°C)</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>

   <Row ss:Height="20">
    <Cell ss:StyleID="Header2"><Data ss:Type="String">3. PERHITUNGAN PENALTI &amp; FROSTSCORE</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableHead"><Data ss:Type="String">Komponen Penalti</Data></Cell>
    <Cell ss:StyleID="TableHead"><Data ss:Type="String">Nilai Komponen (0-100%)</Data></Cell>
    <Cell ss:StyleID="TableHead"><Data ss:Type="String">Bobot Resmi</Data></Cell>
    <Cell ss:StyleID="TableHead"><Data ss:Type="String">Poin Penalti yang Dikenakan</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">P_thermal (Dosis Termal)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">100</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">40%</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">40</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">P_exposure (Durasi Paparan)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">100</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">25%</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">25</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">P_stability (Kestabilan Suhu)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">100</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">15%</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">15</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">P_anomaly (Anomali Sensor AI)</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">20%</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellNormal"><Data ss:Type="String">TOTAL PENALTI (P_total)</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">-</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">100%</Data></Cell>
    <Cell ss:StyleID="CellNumber"><Data ss:Type="Number">80</Data></Cell>
   </Row>
   <Row ss:Height="26">
    <Cell ss:StyleID="ResultRisk"><Data ss:Type="String">FROSTSCORE AKHIR</Data></Cell>
    <Cell ss:StyleID="ResultRisk"><Data ss:Type="Number">20</Data></Cell>
    <Cell ss:StyleID="ResultRisk" ss:MergeAcross="1"><Data ss:Type="String">KATEGORI: RISIKO TINGGI (&lt;60)</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

